 "html": "<style>\r\n\t.print-format table, .print-format tr, \r\n\t.print-format td, .print-format div, .print-format p {\r\n\t\tline-height: 110%;\r\n\t\tvertical-align: middle;\r\n\t}\r\n\r\n\t.print-format table {\r\n\t    margin-top: 0.1rem;\r\n\t    margin-bottom: 0.1rem; \r\n\t    \r\n\t}\r\n\t.print-format hr{\r\n\t   margin-top:5;\r\n\t   margin-bottom:5;\r\n\t}\r\n\t@media screen {\r\n\t\t.print-format {\r\n\t\t\twidth: 8.5in;\r\n\t\t\tpadding: 0.25in;\r\n\t\t\tmin-height: 11in;\r\n\t\t}\r\n\t}\r\n\t@media print {\r\n    .logo-container img {\r\n        max-width: 100px !important;    /* Maximum width when printing */\r\n        max-height: 80px !important;    /* Maximum height when printing */\r\n        width: auto !important;         /* Maintains aspect ratio */\r\n        height: auto !important;        /* Maintains aspect ratio */\r\n    }\r\n}\r\n\t.info-section {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\talign-items: flex-start;\r\n\t\tmargin-bottom: 1rem;\r\n\t}\r\n\t.customer-info {\r\n\t\tflex-grow: 1;\r\n\t\tmargin-right: 20px;\r\n\t}\r\n\t.logo-container {\r\n\t\tflex-shrink: 0;\r\n\t}\r\n\t.logo-container img {\r\n\t\twidth: auto;\r\n\t\tmax-height: 7em;\r\n\t}\r\n\t\r\n</style>\r\n<p class=\"text-center\" style=\"margin-bottom: 1rem\">\r\n\t{{ doc.company }}<br>\r\n\t<b>{{ doc.select_print_heading or _(\"Factura\") }}</b><br>\r\n</p>\r\n<div class=\"info-section\">\r\n\t<div class=\"customer-info\">\r\n\t\t<p>\r\n\t\t\t<b>{{ doc.name }}</b><br>\r\n\t\t\t<b>{{ _(\"Atendido por\") }}:</b> {{ frappe.get_doc(\"User\", doc.owner).full_name}}<br>\r\n\t\t\t<b>{{ _(\"Cliente\") }}:</b> {{ doc.customer_name }}<br>\r\n\t\t\t<b>{{ _(\"Fecha\") }}:</b> {{ doc.get_formatted(\"posting_date\") }}<br>\r\n\t\t\t<b>{{ _(\"Hora\") }}:</b> {{  doc.get_formatted(\"posting_time\") }}<br>\r\n\t\t</p>\r\n\t</div>\r\n\t<div class=\"logo-container\">\r\n\t\t<img src=\"/files/logo2.jpeg\" alt=\"Logo\">\r\n\t</div>\r\n</div>\r\n\r\n<hr>\r\n<table class=\"table table-condensed\">\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th width=\"30%\">{{ _(\"Producto\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Cantidad\") }}</th>\r\n\t\t\t{% if not print_settings.compact_item_print %}\r\n\t\t\t<th width=\"20%\" class=\"text-right\">{{ _(\"P. Unit.\") }}</th>\r\n\t\t\t{% endif %}\r\n\t\t\t<th width=\"20%\" class=\"text-right\">{{ _(\"Valor\") }}</th>\r\n\t\t\t<th width=\"20%\" class=\"text-right\">{{ _(\"ITBIS\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t\t{{ item.item_code }}\r\n\t\t\t\t{%- if item.item_name != item.item_code -%}\r\n\t\t\t\t\t<br>{{ item.item_name }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t\t{%- if item.serial_no -%}\r\n\t\t\t\t\t<br><b>{{ _(\"SR.No\") }}:</b><br>\r\n\t\t\t\t\t{{ item.serial_no | replace(\"\\n\", \", \") }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t{% if print_settings.compact_item_print %}\r\n\t\t\t<td class=\"text-right\">{{ item.qty }}<br>@ {{ item.get_formatted(\"rate\") }}</td>\r\n\t\t\t{% else %}\r\n\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\r\n\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"rate\") }}</td>\r\n\t\t\t{% endif %}\r\n\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\r\n\t\t\t<td class=\"text-right\">{{ '$ 0.00'  }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t</tbody>\r\n</table>\r\n<table class=\"table table-condensed no-border\">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t{% if doc.flags.show_inclusive_tax_in_print %}\r\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\r\n\t\t\t\t\t{{ (\"Total Excl. Tax\") }}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-right\">\r\n\t\t\t\t\t{{ doc.get_formatted(\"net_total\", doc) }}\r\n\t\t\t\t</td>\r\n\t\t\t{% else %}\r\n\t\t\t    {%- if doc.total != doc.grand_total -%}\r\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\r\n\t\t\t\t\t{{ (\"Total\") }}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-right\">\r\n\t\t\t\t\t{{ doc.get_formatted(\"total\", doc) }}\r\n\t\t\t\t</td>\r\n\t\t\t\t{% endif %}\r\n\t\t\t{% endif %}\r\n\t\t</tr>\r\n\t\t{%- for row in doc.taxes -%}\r\n\t\t  {%- if not row.included_in_print_rate or doc.flags.show_inclusive_tax_in_print -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\r\n\t\t\t\t    {% if '%' in row.description %}\r\n\t\t\t\t\t    {{ row.description }}\r\n\t\t\t\t\t{% else %}\r\n\t\t\t\t\t    {{ row.description }}@{{ row.rate }}%\r\n\t\t\t\t\t{% endif %}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-right\">\r\n\t\t\t\t\t{{ row.get_formatted(\"tax_amount\", doc) }}\r\n\t\t\t\t</td>\r\n\t\t\t<tr>\r\n\t\t  {%- endif -%}\r\n\t\t{%- endfor -%}\r\n\t\t\r\n        <br>\r\n\t\t{%- if doc.discount_amount -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t{{ (\"Descuento\") }}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ doc.get_formatted(\"discount_amount\") }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t{%- endif -%}\r\n\t\t\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t<b>{{ (\"Sub-total\") }}</b>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ doc.get_formatted(\"grand_total\") }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t<b>{{ (\"ITBIS\") }}</b>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ '$ 0.00' }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t<b>{{ (\"Total\") }}</b>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ doc.get_formatted(\"grand_total\") }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t\r\n\t\t{%- for row in doc.payments -%}\r\n\t\t    {%- if row.amount -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\r\n\t\t\t\t    {{ _(row.mode_of_payment) }}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-right\">\r\n\t\t\t\t\t{{ row.get_formatted(\"amount\", doc) }}\r\n\t\t\t\t</td>\r\n\t\t\t<tr>\r\n\t\t\t{%- endif -%}    \r\n\t\t{%- endfor -%}\r\n\t\t{%- if doc.change_amount -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t\t<b>{{ (\"Cambio\") }}</b>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-right\">\r\n\t\t\t\t\t{{ doc.get_formatted(\"change_amount\") }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t{%- endif -%}\r\n\t</tbody>\r\n</table>\r\n\r\n<p class=\"text-center\">{{ _(\"Gracias por su compra, vuelva pronto.\") }}</p>",
