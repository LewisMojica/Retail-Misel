 "html": "<style>\r\n\t.print-format table, .print-format tr, \r\n\t.print-format td, .print-format div, .print-format p {\r\n\t\tline-height: 150%;\r\n\t\tvertical-align: middle;\r\n\t}\r\n\t@media screen {\r\n\t\t.print-format {\r\n\t\t\twidth: 8.5in;\r\n\t\t\tpadding: 0.25in;\r\n\t\t\tmin-height: 11in;\r\n\t\t}\r\n\t}\r\n\t@media print {\r\n\t\t.logo-container img {\r\n\t\t\tmax-width: 100px !important;\r\n\t\t\tmax-height: 80px !important;\r\n\t\t\twidth: auto !important;\r\n\t\t\theight: auto !important;\r\n\t\t}\r\n\t}\r\n\t.info-section {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\talign-items: flex-start;\r\n\t\tmargin-bottom: 1rem;\r\n\t}\r\n\t.party-info {\r\n\t\tflex-grow: 1;\r\n\t\tmargin-right: 20px;\r\n\t}\r\n\t.logo-container {\r\n\t\tflex-shrink: 0;\r\n\t}\r\n\t.logo-container img {\r\n\t\tmax-width: 150px;\r\n\t\theight: auto;\r\n\t}\r\n</style>\r\n\r\n<p class=\"text-center\" style=\"margin-bottom: 1rem\">\r\n\t{{ doc.company }}<br>\r\n\t<b>{{ doc.select_print_heading or _(\"Recibo de Pago\") }}</b><br>\r\n</p>\r\n\r\n<div class=\"info-section\">\r\n\t<div class=\"party-info\">\r\n\t\t<p>\r\n\t\t\t<b>{{ doc.name }}</b><br>\r\n\t\t\t<b>{{ _(\"Fecha\") }}:</b> {{ doc.get_formatted(\"posting_date\") }}<br>\r\n\t\t\t<b>{{ _(\"Cliente\") }}:</b> {{ doc.party_name or doc.party }}<br>\r\n\t\t\t<b>{{ _(\"M\u00e9todo de Pago\") }}:</b> {{ _(doc.mode_of_payment) }}<br>\r\n\t\t</p>\r\n\t</div>\r\n\t<div class=\"logo-container\">\r\n\t\t<img src=\"/files/logo2.jpeg\" alt=\"Logo\">\r\n\t</div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<table class=\"table table-condensed\">\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th width=\"60%\">{{ _(\"Referencia\") }}</th>\r\n\t\t\t<th width=\"20%\" class=\"text-right\">{{ _(\"Monto\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for ref in doc.references -%}\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t\t{{ ref.reference_name }}\r\n\t\t\t\t{%- if ref.reference_doctype -%}\r\n\t\t\t\t\t<br><small>{{ _(ref.reference_doctype) }}</small>\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">    {{ frappe.format_value(ref.allocated_amount, {\"fieldtype\":\"Currency\", \"currency\": doc.paid_from_account_currency or doc.paid_to_account_currency}) }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t</tbody>\r\n</table>\r\n\r\n<hr>\r\n\r\n<table class=\"table table-condensed no-border\">\r\n\t<tbody>\r\n\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t<b>{{ _(\"Monto Recibido\") }}</b>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ doc.get_formatted(\"received_amount\") }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t{%- if doc.difference_amount and doc.difference_amount != 0 -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\r\n\t\t\t\t<b>{{ _(\"Diferencia\") }}</b>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">\r\n\t\t\t\t{{ doc.get_formatted(\"difference_amount\") }}\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t{%- endif -%}\r\n\t</tbody>\r\n</table>\r\n\r\n\r\n<p class=\"text-center\">{{ _(\"Gracias por su pago.\") }}</p>\r\n",
