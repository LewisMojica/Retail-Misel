 "html": "<style>\r\n\t.print-format table, .print-format tr, \r\n\t.print-format td, .print-format div, .print-format p {\r\n\t\tline-height: 150%;\r\n\t\tvertical-align: middle;\r\n\t}\r\n\t@media screen {\r\n\t\t.print-format {\r\n\t\t\twidth: 8.5in;\r\n\t\t\tpadding: 0.25in;\r\n\t\t\tmin-height: 11in;\r\n\t\t}\r\n\t}\r\n\t@media print {\r\n\t\t.logo-container img {\r\n\t\t\tmax-width: 100px !important;\r\n\t\t\tmax-height: 80px !important;\r\n\t\t\twidth: auto !important;\r\n\t\t\theight: auto !important;\r\n\t\t}\r\n\t}\r\n\t.info-section {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\talign-items: flex-start;\r\n\t\tmargin-bottom: 1rem;\r\n\t}\r\n\t.customer-info {\r\n\t\tflex-grow: 1;\r\n\t\tmargin-right: 20px;\r\n\t}\r\n\t.logo-container {\r\n\t\tflex-shrink: 0;\r\n\t}\r\n\t.logo-container img {\r\n\t\tmax-width: 150px;\r\n\t\theight: auto;\r\n\t}\r\n</style>\r\n\r\n<p class=\"text-center\" style=\"margin-bottom: 1rem\">\r\n\t{{ doc.company }}<br>\r\n\t<b>{{ doc.select_print_heading or _(\"Nota de Entrega\") }}</b><br>\r\n</p>\r\n\r\n<div class=\"info-section\">\r\n\t<div class=\"customer-info\">\r\n\t\t<p>\r\n\t\t\t<b>{{ doc.name }}</b><br>\r\n\t\t\t<b>{{ _(\"Cliente\") }}:</b> {{ doc.customer_name }}<br>\r\n\t\t\t<b>{{ _(\"Direcci\u00f3n de Entrega\") }}:</b> {{ doc.shipping_address_name or doc.customer_address or \"\" }}<br>\r\n\t\t\t<b>{{ _(\"Fecha de Entrega\") }}:</b> {{ doc.get_formatted(\"posting_date\") }}<br>\r\n\t\t</p>\r\n\t</div>\r\n\t<div class=\"logo-container\">\r\n\t\t<img src=\"/files/logo2.jpeg\" alt=\"Logo\">\r\n\t</div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<table class=\"table table-condensed\">\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th width=\"50%\">{{ _(\"Producto\") }}</th>\r\n\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Cantidad\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t\t{{ item.item_code }}\r\n\t\t\t\t{%- if item.item_name != item.item_code -%}\r\n\t\t\t\t\t<br>{{ item.item_name }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t\t{%- if item.description -%}\r\n\t\t\t\t\t<br><small>{{ item.description }}</small>\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t\t{%- if item.serial_no -%}\r\n\t\t\t\t\t<br><b>{{ _(\"SR.No\") }}:</b><br>\r\n\t\t\t\t\t{{ item.serial_no | replace(\"\\n\", \", \") }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t</tbody>\r\n</table>\r\n\r\n<hr>\r\n\r\n<p>\r\n\t<b>{{ _(\"Observaciones\") }}:</b><br>\r\n\t{{ doc.remarks or \"\" }}\r\n</p>\r\n\r\n<p class=\"text-center\">{{ _(\"Gracias por preferirnos.\") }}</p>\r\n",
